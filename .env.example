# 사이트 주소
#
# canonical, OG 이미지, sitemap 은 절대 주소여야 한다. Vercel 위에서는
# 프로젝트 도메인이 자동으로 들어오므로 비워둬도 되고, 직접 산 도메인을
# 붙였거나 다른 곳에 올린다면 여기에 적는다. 끝의 / 는 없어도 된다.

NEXT_PUBLIC_SITE_URL=

# 펼친 횟수를 담아둘 곳 (Upstash Redis)
#
# 없어도 앱은 그대로 돌아갑니다. 숫자만 보이지 않습니다.
#
# 1. https://console.upstash.com 에서 Redis 데이터베이스를 하나 만듭니다 (무료 등급으로 충분)
# 2. REST API 탭에서 아래 두 값을 복사합니다
# 3. 로컬은 .env.local 에, 배포는 Vercel 프로젝트의 Environment Variables 에 넣습니다

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
